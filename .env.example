# Copia este archivo a .env.local (ignorado por git) y completa los valores.

# Supabase (se exponen al navegador: solo la clave anónima/publicable, nunca la service_role).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# IA de registro por voz. SOLO servidor: sin prefijo VITE_, para que no llegue al bundle.
# En Vercel se configura en Settings > Environment Variables.
ANTHROPIC_API_KEY=
